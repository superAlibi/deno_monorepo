{
  "workspace": ["packages/*", "server", "web"],
  "nodeModulesDir": "auto",
  "unstable": ["temporal", "kv"],
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test",
    "check": "deno check **/*.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
