{
  "name": "@lab/server",
  "exports": "./main.ts",
  "imports": {
    "@hono/zod-openapi": "npm:@hono/zod-openapi@1",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@0.11",
    "hono": "npm:hono@4"
  },
  "tasks": {
    "dev": "deno run --allow-net --allow-env --watch main.ts",
    "start": "deno run --allow-net --allow-env main.ts",
    "export:openapi": "deno run -A scripts/export-openapi.ts"
  }
}
